{
  "$defs": {
    "InsertionAreaAssignment": {
      "additionalProperties": false,
      "description": "The latest of wl.works' `insertion_area_assignment` rows for the\ninsertion: one area, who or what assigned it, and when. Plan 19's row\nlists no atlas column, so none is carried (section 4).",
      "properties": {
        "area": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Area",
          "type": "string"
        },
        "asserted_at": {
          "format": "date-time",
          "title": "Asserted At",
          "type": "string"
        },
        "source": {
          "enum": [
            "histology",
            "functional_mapping",
            "waveform_depth",
            "structural_imaging",
            "at_rig",
            "other"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "area",
        "source",
        "asserted_at"
      ],
      "title": "InsertionAreaAssignment",
      "type": "object"
    },
    "InsertionTarget": {
      "additionalProperties": false,
      "description": "The insertion's aim, as wl.works' `item_insertion` holds it:\n`targetArea`, `atlas` and `atlasLevel`, \"a copy of the plan's target\"\n(its Plan 19). All three or none (design spec\n`2026-09-30-nwb-probes-design.md` section 4): an area without its atlas\nnames no place.",
      "properties": {
        "area": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Area",
          "type": "string"
        },
        "atlas": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Atlas",
          "type": "string"
        },
        "atlas_level": {
          "maximum": 255,
          "minimum": 0,
          "title": "Atlas Level",
          "type": "integer"
        }
      },
      "required": [
        "area",
        "atlas",
        "atlas_level"
      ],
      "title": "InsertionTarget",
      "type": "object"
    },
    "MetadataBundle": {
      "additionalProperties": false,
      "description": "Everything wl-preproc needs from the ELN, carried inbound with the request.",
      "properties": {
        "blocks": {
          "default": [],
          "deprecated": true,
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 0,
          "title": "Blocks",
          "type": "array"
        },
        "experimenter": {
          "title": "Experimenter",
          "type": "string"
        },
        "montage_boundaries": {
          "items": {
            "$ref": "#/$defs/MontageBoundary"
          },
          "title": "Montage Boundaries",
          "type": "array"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/ProbeEntry"
          },
          "title": "Probes",
          "type": "array"
        },
        "runs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RunEntry"
          },
          "title": "Runs",
          "type": "array"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "subject_details": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_types": {
          "items": {
            "type": "string"
          },
          "title": "Task Types",
          "type": "array"
        }
      },
      "required": [
        "montage_boundaries",
        "probes",
        "experimenter",
        "subject",
        "task_types"
      ],
      "title": "MetadataBundle",
      "type": "object"
    },
    "MontageBoundary": {
      "additionalProperties": false,
      "description": "One maximal interval with no probe movement and no bank change, as\nwl.works asserts it -- design spec section 8.3's \"recording montage\".\n\nTyped rather than `dict[str, Any]` because this payload is a frozen\ninterface with a second implementer: section 11.2 records that wl.works'\n18b tests are contract tests against a *fake* wl-preproc, and a fake can\nonly be built from what the contract writes down. An untyped list exports\nto `{\"type\": \"object\", \"additionalProperties\": true}`, which tells that\nimplementer nothing at all -- while `responder/jobs.py` validated these\nfields anyway, in a module no other repository reads.",
      "properties": {
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "montage_id": {
          "maximum": 127,
          "minimum": -128,
          "title": "Montage Id",
          "type": "integer"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "montage_id",
        "start_s",
        "end_s"
      ],
      "title": "MontageBoundary",
      "type": "object"
    },
    "ProbeEntry": {
      "additionalProperties": false,
      "description": "One penetration: which probe, which insertion, and which trajectory it\nran against. Section 11.2's payload block, verbatim: *\"probe serials +\ninsertions, trajectory_id per insertion\"*.",
      "properties": {
        "area_assignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/InsertionAreaAssignment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "insertion_number": {
          "maximum": 255,
          "minimum": 0,
          "title": "Insertion Number",
          "type": "integer"
        },
        "serial": {
          "maxLength": 32,
          "title": "Serial",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/InsertionTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trajectory_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory Id"
        }
      },
      "required": [
        "serial",
        "insertion_number"
      ],
      "title": "ProbeEntry",
      "type": "object"
    },
    "RunEntry": {
      "additionalProperties": false,
      "description": "One run wl.works holds for the session: its copy of a run `GET\n/sessions` listed, measured from the recording, and its own id for it\n(design spec `2026-10-01-session-listing-and-run-requests-design.md`\nsection 3.1). Checked against `core.Run` as the request arrives.",
      "properties": {
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "run_number": {
          "maximum": 32767,
          "minimum": 1,
          "title": "Run Number",
          "type": "integer"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "works_run_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Works Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_number",
        "start_s",
        "end_s",
        "works_run_id"
      ],
      "title": "RunEntry",
      "type": "object"
    },
    "SubjectDetails": {
      "additionalProperties": false,
      "description": "The animal, as wl.works' own record states it: what an NWB file's\n`subject` needs beyond an id (design spec\n`2026-09-28-nwb-builder-design.md` section 9, the requester's decision\nof 2026-09-28). Optional in the request; `responder/jobs.py::accept`\nwrites it into element-animal's own tables, replacing the stub\n`ingest/landing.py` lands.",
      "properties": {
        "date_of_birth": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Of Birth"
        },
        "sex": {
          "default": "U",
          "enum": [
            "M",
            "F",
            "U"
          ],
          "title": "Sex",
          "type": "string"
        },
        "species": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Species"
        }
      },
      "title": "SubjectDetails",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/MetadataBundle"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "selection": {
      "additionalProperties": true,
      "title": "Selection",
      "type": "object"
    }
  },
  "required": [
    "domain",
    "selection",
    "parameters",
    "idempotency_key",
    "metadata"
  ],
  "title": "JobRequest",
  "type": "object"
}
