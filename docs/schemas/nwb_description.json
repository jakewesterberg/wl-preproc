{
  "$defs": {
    "Behaviour": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "title": "Events",
          "type": "integer"
        },
        "trials": {
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "trials",
        "events"
      ],
      "title": "Behaviour",
      "type": "object"
    },
    "Checksums": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "datasets": {
          "items": {
            "$ref": "#/$defs/DatasetChecksum"
          },
          "title": "Datasets",
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "datasets"
      ],
      "title": "Checksums",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "One condition that ran in a run: by its name in the rig's record,\nwith the settings constant across its trials and a summary of those that\nvaried; or, without that record, by the stream's CONDITION number with\nsettings unknown (null).",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "settings": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Settings"
        },
        "trials": {
          "$ref": "#/$defs/TrialCounts"
        },
        "varying": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Varying"
        }
      },
      "required": [
        "name",
        "code",
        "settings",
        "varying",
        "trials"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "title": "Coverage",
          "type": "string"
        },
        "covered_s": {
          "title": "Covered S",
          "type": "number"
        }
      },
      "required": [
        "coverage",
        "covered_s"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DataTypes": {
      "additionalProperties": false,
      "properties": {
        "behaviour": {
          "$ref": "#/$defs/Behaviour"
        },
        "ephys": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ephys"
        },
        "eye": {
          "anyOf": [
            {
              "$ref": "#/$defs/EyeData"
            },
            {
              "type": "null"
            }
          ]
        },
        "eye_events": {
          "anyOf": [
            {
              "$ref": "#/$defs/EyeEvents"
            },
            {
              "type": "null"
            }
          ]
        },
        "photodiode": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Photodiode"
        },
        "stimulation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stimulation"
        },
        "video": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video"
        }
      },
      "required": [
        "eye",
        "eye_events",
        "behaviour"
      ],
      "title": "DataTypes",
      "type": "object"
    },
    "DatasetChecksum": {
      "additionalProperties": false,
      "properties": {
        "dataset_path": {
          "title": "Dataset Path",
          "type": "string"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "paired_with": {
          "title": "Paired With",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "title": "Shape",
          "type": "string"
        }
      },
      "required": [
        "dataset_path",
        "dtype",
        "shape",
        "sha256",
        "paired_with"
      ],
      "title": "DatasetChecksum",
      "type": "object"
    },
    "EyeData": {
      "additionalProperties": false,
      "properties": {
        "gaze": {
          "items": {
            "enum": [
              "left",
              "right"
            ],
            "type": "string"
          },
          "title": "Gaze",
          "type": "array"
        },
        "pupil": {
          "items": {
            "enum": [
              "left",
              "right"
            ],
            "type": "string"
          },
          "title": "Pupil",
          "type": "array"
        }
      },
      "required": [
        "gaze",
        "pupil"
      ],
      "title": "EyeData",
      "type": "object"
    },
    "EyeEvents": {
      "additionalProperties": false,
      "properties": {
        "detectors": {
          "items": {
            "type": "string"
          },
          "title": "Detectors",
          "type": "array"
        }
      },
      "required": [
        "detectors"
      ],
      "title": "EyeEvents",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "activation_id": {
          "title": "Activation Id",
          "type": "integer"
        },
        "built_at": {
          "format": "date-time",
          "title": "Built At",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "montage_id": {
          "title": "Montage Id",
          "type": "integer"
        },
        "n_critical": {
          "title": "N Critical",
          "type": "integer"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipeline"
        },
        "rig": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rig"
        },
        "role": {
          "enum": [
            "canonical",
            "derivative"
          ],
          "title": "Role",
          "type": "string"
        },
        "session_datetime": {
          "format": "date-time",
          "title": "Session Datetime",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "written",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "supersedes_activation_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes Activation Id"
        }
      },
      "required": [
        "identifier",
        "subject",
        "session_id",
        "session_datetime",
        "rig",
        "montage_id",
        "activation_id",
        "role",
        "supersedes_activation_id",
        "built_at",
        "pipeline",
        "status",
        "n_critical"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "stop_s": {
          "title": "Stop S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "stop_s"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Pipeline": {
      "additionalProperties": false,
      "description": "The code that built the file. The commit is the provenance: the\npackage's own version is a constant that has never moved, and reading it\nneeds `importlib`, which `tests/test_cli_guardrails.py` bans outright.",
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commit"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "commit"
      ],
      "title": "Pipeline",
      "type": "object"
    },
    "ProbeAssignment": {
      "additionalProperties": false,
      "description": "The latest area wl.works had assigned the insertion when the file was\nbuilt. A later one does not rewrite the file.",
      "properties": {
        "area": {
          "title": "Area",
          "type": "string"
        },
        "asserted_at": {
          "format": "date-time",
          "title": "Asserted At",
          "type": "string"
        },
        "source": {
          "enum": [
            "histology",
            "functional_mapping",
            "waveform_depth",
            "structural_imaging",
            "at_rig",
            "other"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "area",
        "source",
        "asserted_at"
      ],
      "title": "ProbeAssignment",
      "type": "object"
    },
    "ProbeInfo": {
      "additionalProperties": false,
      "description": "One probe in the file: the serial and type from the recording (or\nfrom wl.works' report when no recording names it), its insertion from\nthe report, the active sites the file holds, and both areas. `area_from`\nsays which one the file's area label came from.",
      "properties": {
        "area_from": {
          "enum": [
            "assignment",
            "target",
            "unknown"
          ],
          "title": "Area From",
          "type": "string"
        },
        "assignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbeAssignment"
            },
            {
              "type": "null"
            }
          ]
        },
        "insertion_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Insertion Number"
        },
        "n_electrodes": {
          "title": "N Electrodes",
          "type": "integer"
        },
        "probe_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probe Type"
        },
        "serial": {
          "title": "Serial",
          "type": "string"
        },
        "sorted_runs": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Sorted Runs",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbeTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "trajectory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trajectory Id"
        }
      },
      "required": [
        "serial",
        "probe_type",
        "insertion_number",
        "trajectory_id",
        "n_electrodes",
        "target",
        "assignment",
        "area_from"
      ],
      "title": "ProbeInfo",
      "type": "object"
    },
    "ProbeTarget": {
      "additionalProperties": false,
      "description": "The insertion's aim, as wl.works reported it.",
      "properties": {
        "area": {
          "title": "Area",
          "type": "string"
        },
        "atlas": {
          "title": "Atlas",
          "type": "string"
        },
        "atlas_level": {
          "title": "Atlas Level",
          "type": "integer"
        }
      },
      "required": [
        "area",
        "atlas",
        "atlas_level"
      ],
      "title": "ProbeTarget",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "eye_usable_fraction": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "left",
              "right"
            ]
          },
          "title": "Eye Usable Fraction",
          "type": "object"
        },
        "reference_source": {
          "enum": [
            "barcode",
            "manifest"
          ],
          "title": "Reference Source",
          "type": "string"
        },
        "timing_tier": {
          "title": "Timing Tier",
          "type": "string"
        }
      },
      "required": [
        "timing_tier",
        "reference_source",
        "eye_usable_fraction"
      ],
      "title": "Quality",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "One run the file holds, measured from the recording. `works_run_id`\njoins it to wl.works' `animal_session_run`.",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/RunBlock"
          },
          "title": "Blocks",
          "type": "array"
        },
        "closed": {
          "title": "Closed",
          "type": "boolean"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "coverage": {
          "additionalProperties": {
            "$ref": "#/$defs/Coverage"
          },
          "title": "Coverage",
          "type": "object"
        },
        "measured": {
          "$ref": "#/$defs/Interval"
        },
        "run_number": {
          "title": "Run Number",
          "type": "integer"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "trials": {
          "$ref": "#/$defs/TrialCounts"
        },
        "works_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Works Run Id"
        }
      },
      "required": [
        "run_number",
        "works_run_id",
        "task",
        "measured",
        "closed",
        "trials",
        "coverage",
        "conditions",
        "blocks"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunBlock": {
      "additionalProperties": false,
      "description": "A measured block inside the run: consecutive trials under one block\ntype. `block_number` is its number in the session, as `BLOCK_START`\nstrobes it; `closed` is null when never recorded.",
      "properties": {
        "block_in_run": {
          "title": "Block In Run",
          "type": "integer"
        },
        "block_number": {
          "title": "Block Number",
          "type": "integer"
        },
        "block_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Type"
        },
        "closed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closed"
        },
        "measured": {
          "$ref": "#/$defs/Interval"
        },
        "trials": {
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "block_number",
        "block_in_run",
        "block_type",
        "measured",
        "closed",
        "trials"
      ],
      "title": "RunBlock",
      "type": "object"
    },
    "SubjectInfo": {
      "additionalProperties": false,
      "properties": {
        "age_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Age Days"
        },
        "date_of_birth": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Of Birth"
        },
        "sex": {
          "enum": [
            "M",
            "F",
            "U"
          ],
          "title": "Sex",
          "type": "string"
        },
        "species": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Species"
        }
      },
      "required": [
        "species",
        "sex",
        "date_of_birth",
        "age_days"
      ],
      "title": "SubjectInfo",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "code",
        "name"
      ],
      "title": "Task",
      "type": "object"
    },
    "TrialCounts": {
      "additionalProperties": false,
      "properties": {
        "by_outcome": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Outcome",
          "type": "object"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "by_outcome"
      ],
      "title": "TrialCounts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checksums": {
      "$ref": "#/$defs/Checksums"
    },
    "data_types": {
      "$ref": "#/$defs/DataTypes"
    },
    "identity": {
      "$ref": "#/$defs/Identity"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "probes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProbeInfo"
      },
      "title": "Probes",
      "type": "array"
    },
    "processing": {
      "additionalProperties": true,
      "default": {},
      "title": "Processing",
      "type": "object"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/Run"
      },
      "title": "Runs",
      "type": "array"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "subject": {
      "$ref": "#/$defs/SubjectInfo"
    }
  },
  "required": [
    "identity",
    "subject",
    "data_types",
    "runs",
    "quality",
    "notes",
    "checksums"
  ],
  "title": "NwbDescription",
  "type": "object"
}
